# Copy to .env and fill in. Every setting in app/config.py can be set here with the ICORE_ prefix.
ICORE_API_TOKEN=change-me

# Speech-to-text (faster-whisper)
ICORE_STT_MODEL=large-v3        # most accurate on our Egyptian test set; large-v3-turbo is ~2.6x faster
ICORE_STT_DEVICE=cpu            # server with NVIDIA GPU: cuda
ICORE_STT_COMPUTE_TYPE=int8     # GPU: float16

# Text-to-speech: piper (light, local testing) or chatterbox (needs: uv sync --extra chatterbox)
ICORE_TTS_ENGINE=piper
ICORE_CHATTERBOX_DEVICE=mps     # Apple Silicon: mps, NVIDIA: cuda, otherwise cpu

ICORE_PRELOAD_MODELS=false
ICORE_MAX_UPLOAD_MB=25
ICORE_MAX_AUDIO_SECONDS=600
ICORE_MAX_TEXT_CHARS=1000

# Recording page at /collect (writes audio to evaluation/). Keep false on shared servers.
ICORE_ENABLE_COLLECTION=false
# Egyptian context sentence sent with Arabic requests (empty = off)
# ICORE_STT_DIALECT_PROMPT=
